{
  "name": "observatorio-rondonia",
  "version": "0.4.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "map:build": "node scripts/build-municipal-map.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "worker:receitas": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/revenues-worker.ts"
  },
  "dependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
